# ─── Sitio ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://guiapromptsia.com"
NEXT_PUBLIC_SITE_NAME="Guía Prompts IA"

# ─── Google AdSense ───────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-1950156439970490"

# ─── Unsplash (opcional) ──────────────────────────────────────
# Las imágenes de las cards ya están fijadas en content/*.json y lib/images.ts
# (URLs directas a images.unsplash.com, con atribución guardada junto a cada
# entrada). Esta clave solo es necesaria si en el futuro quieres volver a
# ejecutar scripts/fetch-unsplash-images.js contra la API oficial de Unsplash
# para regenerar o ampliar el catálogo — créala gratis en
# https://unsplash.com/developers (app en modo "Demo" es suficiente).
UNSPLASH_ACCESS_KEY=""

# ─── Google Indexing API (opcional) ───────────────────────────
# Solo necesario para `npm run submit:indexing` (notifica URLs nuevas/
# actualizadas a Google para acelerar su indexación). Requiere crear una
# cuenta de servicio en Google Cloud Console y añadirla como propietaria en
# Search Console — ver el comentario al inicio de scripts/submit-to-indexing-api.mjs.
# Pega aquí el JSON completo de la clave (o guárdalo como
# google-service-account.json en la raíz del proyecto).
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ─── Formularios (opcional) ───────────────────────────────────
# Sitio 100% estático: sin backend propio para contacto/newsletter.
# Configura un endpoint externo (Formspree, Web3Forms, etc.) para
# activar el envío real; si se deja vacío, el formulario lo indica
# y sugiere escribir directamente por email.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=""
NEXT_PUBLIC_NEWSLETTER_FORM_ENDPOINT=""
